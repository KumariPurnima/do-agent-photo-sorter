# App
APP_NAME=Agent Photo Sorter
DEMO_MODE=true
# Site password protection (HTTP Basic Auth). Leave APP_PASSWORD empty to disable locally.
APP_USERNAME=admin
APP_PASSWORD=

# DigitalOcean API (required for live Harness launches)
DIGITALOCEAN_TOKEN=
DOCTL_BIN=doctl

# Serverless Inference / Harness model access key
HARNESS_INFERENCE_API_KEY=
HARNESS_INFERENCE_MODEL=anthropic-claude-5-sonnet
# Optional vision model override for scripts/label.py
PHOTO_SORTER_VLM_MODEL=nemotron-3.5-super-vl

# Spaces
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=nyc3
SPACES_BUCKET=
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_PREFIX=albums/default
